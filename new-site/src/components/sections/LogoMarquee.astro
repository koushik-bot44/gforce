---
// Restore the earlier transparent wordmarks from the supplied client list.
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import { clientLogos } from '../../data/site';
interface Props { id?: string; compact?: boolean; }
const { id = 'client-logos', compact = false } = Astro.props;
const titleId = `${id}-title`;
const logos = clientLogos.flatMap((logo) => {
  const src = `/logos/clients/mono/${logo.file.replace(/\.(gif|jpg)$/i, '.png')}`;
  const path = join(process.cwd(), 'public', src);
  if (!existsSync(path)) return [];
  const png = readFileSync(path);
  return [{ ...logo, src, width: png.readUInt32BE(16), height: png.readUInt32BE(20) }];
});
---
<section class:list={['marquee', { 'marquee-compact': compact }]} data-marquee aria-labelledby={titleId} style={`--marquee-duration: ${logos.length * 4}s`}>
  <div class="container-g marquee-head">
    <h2 id={titleId} class="t-h3">Our clients</h2>
    {!compact && <p class="marquee-description">Organizations we have worked with.</p>}
  </div>
  <div class="marquee-viewport" tabindex="0" role="region" aria-label="Client company logos" aria-describedby={`${id}-help`}>
    <span class="sr-only" id={`${id}-help`}>Focus, hover or touch this row to stop automatic scrolling. Use the arrow keys or swipe to browse the companies.</span>
    <div class="marquee-track">
      <ul class="marquee-list" role="list" aria-labelledby={titleId}>
        {logos.map((logo) => <li class="client-logo"><img src={logo.src} alt={logo.name} width={logo.width} height={logo.height} loading="lazy" decoding="async" fetchpriority="low" /></li>)}
      </ul>
      <ul class="marquee-list marquee-duplicate" aria-hidden="true" inert>
        {logos.map((logo) => <li class="client-logo"><img src={logo.src} alt="" width={logo.width} height={logo.height} loading="lazy" decoding="async" fetchpriority="low" /></li>)}
      </ul>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((band) => {
    const viewport = band.querySelector<HTMLElement>('.marquee-viewport')!;
    const track = band.querySelector<HTMLElement>('.marquee-track')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let loaded = false, visible = false, manual = false;
    const sync = () => {
      band.toggleAttribute('data-animated', loaded && !reduced.matches && !manual);
      band.toggleAttribute('data-resting', !visible || document.hidden);
    };
    const browse = () => {
      if (manual) return;
      const transform = getComputedStyle(track).transform;
      const offset = transform === 'none' ? 0 : -new DOMMatrix(transform).m41;
      const wasAnimated = band.hasAttribute('data-animated');
      manual = true;
      band.setAttribute('data-manual', '');
      sync();
      // Replace the transform with an equal native scroll offset in the same
      // frame. Direct interaction stops the loop without a visible jump/button.
      if (wasAnimated) viewport.scrollLeft = offset;
    };
    viewport.addEventListener('pointerenter', (event) => { if (event.pointerType === 'mouse') browse(); });
    viewport.addEventListener('pointerdown', browse, { passive: true });
    viewport.addEventListener('wheel', browse, { passive: true });
    viewport.addEventListener('focus', browse);
    viewport.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      browse();
      const left = event.key === 'Home' ? 0 : event.key === 'End' ? viewport.scrollWidth :
        viewport.scrollLeft + (event.key === 'ArrowRight' ? 1 : -1) * viewport.clientWidth * .7;
      viewport.scrollTo({ left, behavior: reduced.matches ? 'instant' : 'smooth' });
    });
    reduced.addEventListener('change', sync);
    document.addEventListener('visibilitychange', sync);
    addEventListener('pageshow', sync);
    if (!('IntersectionObserver' in window)) return;
    new IntersectionObserver((entries) => { visible = entries.some((entry) => entry.isIntersecting); sync(); }).observe(band);
    const near = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      near.disconnect();
      const images = Array.from(band.querySelectorAll('img'));
      images.forEach((image) => image.loading = 'eager');
      Promise.all(images.map((image) => image.decode().catch(() => {}))).then(() => { loaded = true; sync(); });
    }, { rootMargin: '240px 0px' });
    near.observe(band);
    sync();
  });
</script>

<style>
  .marquee {
    --logo-gap: 2.5rem;
    min-width: 0;
    padding-block: clamp(2.5rem, 4vw, 4rem);
    background: var(--bg);
    color: var(--text);
    overflow: clip;
  }
  .marquee-head { display: grid; gap: .5rem; margin-bottom: 1.5rem; }
  .marquee-description { color: var(--text-muted); font-size: .9375rem; }
  .marquee-viewport { overflow-x: auto; scrollbar-width: thin; padding: .5rem var(--gutter); }
  .marquee-viewport:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
  .marquee-track { display: flex; width: max-content; }
  .marquee-list { display: flex; align-items: center; gap: var(--logo-gap); flex: none; margin: 0; padding: 0 var(--logo-gap) 0 0; list-style: none; }
  .marquee-duplicate { display: none; }
  .client-logo { display: grid; place-items: center; flex: none; height: 2rem; }
  .client-logo img { display: block; height: 1.75rem; width: auto; max-width: none; opacity: .65; }
  :global(html[data-theme='dark']) .marquee:not(.marquee-compact) .client-logo img { filter: invert(1); opacity: .8; }
  .marquee-compact { padding-block: 0; width: 100%; background: transparent; text-align: center; }
  .marquee-compact .marquee-head { width: 100%; margin-bottom: 1rem; }
  .marquee-compact h2 { font-size: .9375rem; font-weight: 550; letter-spacing: 0; }
  .marquee-compact .marquee-viewport { padding-inline: 0; }
  .marquee[data-manual] .marquee-duplicate { display: flex; }
  @media (min-width: 768px) { .marquee { --logo-gap: 3.5rem; } }
  @media (prefers-reduced-motion: no-preference) {
    .marquee[data-animated] .marquee-viewport { overflow: clip; mask-image: linear-gradient(90deg, transparent, black 1rem, black calc(100% - 1rem), transparent); }
    .marquee[data-animated] .marquee-track { animation: client-scroll var(--marquee-duration) linear infinite; will-change: transform; }
    .marquee[data-animated] .marquee-duplicate { display: flex; }
    .marquee[data-resting] .marquee-track { animation-play-state: paused; }
  }
  @keyframes client-scroll { to { transform: translate3d(-50%, 0, 0); } }
</style>
